  author = {Barreto-Cubero, Andres J. and Gómez-Espinosa, Alfonso and Escobedo Cabello, Jesús Arturo and Cuan-Urquizo, Enrique and Cruz-Ramírez, Sergio R.},
  date = {2022-01},
  journaltitle = {Sensors},
  volume = {22},
  number = {1},
  pages = {305},

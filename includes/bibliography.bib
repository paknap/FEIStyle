  date = {2019-07-01},
  journaltitle = {Robotics and Autonomous Systems},
  shortjournal = {Robotics and Autonomous Systems},
  volume = {117},
  pages = {1--16},
  issn = {0921-8890},
  doi = {10.1016/j.robot.2019.03.012},

  booktitle = {2018 {{IEEE}}/{{CVF Conference}} on {{Computer Vision}} and {{Pattern Recognition Workshops}} ({{CVPRW}})},
  author = {Kaneko, Masaya and Iwami, Kazuya and Ogawa, Torn and Yamasaki, Toshihiko and Aizawa, Kiyoharu},
  date = {2018-06},
  pages = {371--3718},
  publisher = {IEEE},

  author = {Ferreira, J. and Vale, A. and Ventura, R.},
  date = {2013-06-01},
  journaltitle = {IFAC Proceedings Volumes},
  shortjournal = {IFAC Proceedings Volumes},
  series = {8th {{IFAC Symposium}} on {{Intelligent Autonomous Vehicles}}},
